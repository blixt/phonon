{
  "name": "phonon-webgpu",
  "version": "0.1.0",
  "description": "Phonon 31M text-to-speech on WebGPU, with the time of every word.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/phonon.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "NOTICE",
    "LICENSE"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --target=es2022 --outfile=dist/phonon.js && esbuild src/cpu-worker.ts --bundle --format=esm --target=es2022 --outfile=dist/phonon-cpu.js && npm run site && tsc -p tsconfig.build.json",
    "check": "tsc -p . --noEmit",
    "bench": "node bench/run.mjs",
    "test": "esbuild src/*.test.ts --bundle --platform=node --format=esm --outdir=.test --log-level=warning && node --test .test/",
    "build-weights": "esbuild scripts/build-weights.ts --bundle --platform=node --format=esm --outfile=.test/build-weights.mjs --log-level=warning && node .test/build-weights.mjs",
    "site": "esbuild site/site.ts --bundle --format=esm --target=es2022 --minify --outfile=docs/site.js && esbuild scripts/build-site.ts --bundle --platform=node --format=esm --packages=external --outfile=.test/build-site.mjs --log-level=warning && node .test/build-site.mjs",
    "build-cpu": "sh cpu/build.sh"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "kokoro-js": "^1.2.1",
    "marked": "^18.1.2",
    "phonon-tts": "^0.6.0",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/blixt/phonon"
  }
}
